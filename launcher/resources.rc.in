#include <winres.h>

1 ICON "@SRC_DIR@/favicon.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@SRC_DIR@/resources.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
PRODUCTVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IIIIIllllIIIIIlllll"
            VALUE "FileDescription", "llama.cpp-hub Launcher"
            VALUE "FileVersion", "@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@.0"
            VALUE "InternalName", "llama.cpp-hub"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "llama.cpp-hub.exe"
            VALUE "ProductName", "llama.cpp-hub"
            VALUE "ProductVersion", "@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
